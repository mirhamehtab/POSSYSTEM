@{
    ViewData["Title"] = "New Purchase";
}

<h1>New Purchase</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Supplier</label>
        <select id="supplierSelect" class="form-select">
            <option value="">-- Select Supplier --</option>
            @foreach (var s in (List<POSSystem.Models.Supplier>)ViewBag.Suppliers)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Supplier Invoice No (optional)</label>
        <input type="text" id="supplierInvoiceNo" class="form-control" />
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <input type="text" id="searchBox" class="form-control mb-2" placeholder="Search product by name or SKU..." />
        <div id="searchResults" class="list-group mb-3"></div>

        <table class="table">
            <thead>
                <tr><th>Product</th><th>Qty</th><th>Unit Cost</th><th>Line Total</th><th></th></tr>
            </thead>
            <tbody id="lineBody"></tbody>
        </table>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <label class="form-label">Notes</label>
            <textarea id="notes" class="form-control mb-3" rows="3"></textarea>

            <div class="d-flex justify-content-between fw-bold fs-5">
                <span>Total</span><span id="totalDisplay">0.00</span>
            </div>

            <button id="saveDraftBtn" class="btn btn-primary w-100 mt-3">Save as Draft</button>
            <div id="resultMessage" class="mt-2"></div>
        </div>
    </div>
</div>

<form id="antiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        const antiForgeryToken = document.querySelector('#antiForgeryForm input[name=__RequestVerificationToken]').value;

        let lines = [];

        const searchBox = document.getElementById('searchBox');
        const searchResults = document.getElementById('searchResults');
        const lineBody = document.getElementById('lineBody');
        const saveDraftBtn = document.getElementById('saveDraftBtn');

        function debounce(fn, delay) {
            let t;
            return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), delay); };
        }

        searchBox.addEventListener('input', debounce(async function () {
            const term = searchBox.value.trim();
            if (!term) { searchResults.innerHTML = ''; return; }

            const res = await fetch('/Sales/SearchProducts?term=' + encodeURIComponent(term));
            const products = await res.json();

            searchResults.innerHTML = products.map(function (p) {
                return '<button type="button" class="list-group-item list-group-item-action" onclick="addLine(' + p.id + ', \'' + p.name.replace(/'/g, "\\'") + '\')">' +
                    p.name + ' (' + p.sku + ') -- current stock: ' + p.currentStock +
                    '</button>';
            }).join('');
        }, 300));

        function addLine(productId, name) {
            if (lines.find(function (l) { return l.productId === productId; })) { alert('Already added.'); return; }
            lines.push({ productId: productId, name: name, qty: 1, unitCost: 0 });
            searchBox.value = '';
            searchResults.innerHTML = '';
            renderLines();
        }

        function updateLine(productId, field, value) {
            const line = lines.find(function (l) { return l.productId === productId; });
            if (!line) return;
            line[field] = parseFloat(value) || 0;
            renderLines();
        }

        function removeLine(productId) {
            lines = lines.filter(function (l) { return l.productId !== productId; });
            renderLines();
        }

        function renderLines() {
            lineBody.innerHTML = lines.map(function (l) {
                return '<tr>' +
                    '<td>' + l.name + '</td>' +
                    '<td><input type="number" value="' + l.qty + '" min="1" style="width:70px" onchange="updateLine(' + l.productId + ', \'qty\', this.value)" /></td>' +
                    '<td><input type="number" value="' + l.unitCost + '" min="0" step="0.01" style="width:90px" onchange="updateLine(' + l.productId + ', \'unitCost\', this.value)" /></td>' +
                    '<td>' + (l.qty * l.unitCost).toFixed(2) + '</td>' +
                    '<td><button class="btn btn-sm btn-danger" onclick="removeLine(' + l.productId + ')">x</button></td>' +
                    '</tr>';
            }).join('');

            const total = lines.reduce(function (sum, l) { return sum + l.qty * l.unitCost; }, 0);
            document.getElementById('totalDisplay').textContent = total.toFixed(2);
        }

        saveDraftBtn.addEventListener('click', async function () {
            const supplierId = document.getElementById('supplierSelect').value;
            if (!supplierId) { alert('Select a supplier.'); return; }
            if (lines.length === 0) { alert('Add at least one product.'); return; }

            const btn = this;
            btn.disabled = true;
            btn.textContent = 'Saving...';

            try {
                const payload = {
                    supplierId: parseInt(supplierId),
                    supplierInvoiceNo: document.getElementById('supplierInvoiceNo').value,
                    notes: document.getElementById('notes').value,
                    items: lines.map(function (l) {
                        return { productId: l.productId, quantity: l.qty, unitCost: l.unitCost };
                    })
                };

                const res = await fetch('/Purchases/SaveDraft', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });

                const result = await res.json();
                const msgDiv = document.getElementById('resultMessage');

                if (!res.ok) {
                    msgDiv.innerHTML = '<div class="alert alert-danger">' + result.message + '</div>';
                    return;
                }

                msgDiv.innerHTML = '<div class="alert alert-success">Saved as ' + result.purchaseNo + '. <a href="/Purchases">Go to Purchases list</a> to receive it.</div>';
                lines = [];
                renderLines();
            } finally {
                btn.disabled = false;
                btn.textContent = 'Save as Draft';
            }
        });
    </script>
}