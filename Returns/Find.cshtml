@{
    ViewData["Title"] = "Process Return";
}

<h1>Process Return</h1>

<div class="row mb-3">
    <div class="col-md-5">
        <label class="form-label">Invoice Number</label>
        <div class="input-group">
            <input type="text" id="invoiceInput" class="form-control" placeholder="e.g. INV-00001" />
            <button id="findBtn" class="btn btn-primary">Find Sale</button>
        </div>
        <div id="findError" class="text-danger mt-1"></div>
    </div>
</div>

<div id="returnSection" style="display:none">
    <table class="table">
        <thead>
            <tr><th>Product</th><th>Sold Qty</th><th>Already Returned</th><th>Return Qty</th><th>Unit Price</th></tr>
        </thead>
        <tbody id="itemsBody"></tbody>
    </table>

    <div class="row">
        <div class="col-md-4">
            <label class="form-label">Reason</label>
            <select id="reason" class="form-select">
                <option value="Defective">Defective</option>
                <option value="Wrong item">Wrong item</option>
                <option value="Customer changed mind">Customer changed mind</option>
                <option value="Other">Other</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Refund Method</label>
            <select id="refundMethod" class="form-select">
                <option value="Cash">Cash</option>
                <option value="Card">Card</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="Mobile Payment">Mobile Payment</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Notes (optional)</label>
            <input type="text" id="notes" class="form-control" />
        </div>
    </div>

    <div class="d-flex justify-content-between fw-bold fs-5 mt-3">
        <span>Refund Total</span><span id="refundDisplay">0.00</span>
    </div>

    <button id="processBtn" class="btn btn-danger mt-3">Process Return</button>
    <div id="resultMessage" class="mt-2"></div>
</div>

<form id="antiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        const antiForgeryToken = document.querySelector('#antiForgeryForm input[name=__RequestVerificationToken]').value;

        let currentSaleId = null;
        let currentItems = [];

        const invoiceInput = document.getElementById('invoiceInput');
        const findBtn = document.getElementById('findBtn');
        const findError = document.getElementById('findError');
        const returnSection = document.getElementById('returnSection');
        const itemsBody = document.getElementById('itemsBody');
        const processBtn = document.getElementById('processBtn');

        findBtn.addEventListener('click', async function () {
            findError.textContent = '';
            const invoiceNo = invoiceInput.value.trim();
            if (!invoiceNo) return;

            const res = await fetch('/Returns/SearchSale?invoiceNo=' + encodeURIComponent(invoiceNo));

            if (!res.ok) {
                const err = await res.json();
                findError.textContent = err.message;
                returnSection.style.display = 'none';
                return;
            }

            const data = await res.json();
            currentSaleId = data.saleId;
            currentItems = data.items;
            renderItems();
            returnSection.style.display = 'block';
        });

        function renderItems() {
            itemsBody.innerHTML = currentItems.map(function (i) {
                return '<tr>' +
                    '<td>' + i.name + '</td>' +
                    '<td>' + i.soldQty + '</td>' +
                    '<td>' + i.alreadyReturned + '</td>' +
                    '<td><input type="number" min="0" max="' + i.eligibleQty + '" value="0" style="width:70px" data-saleitemid="' + i.saleItemId + '" class="qtyInput" onchange="recalc()" /> / ' + i.eligibleQty + '</td>' +
                    '<td>' + i.unitPrice.toFixed(2) + '</td>' +
                    '</tr>';
            }).join('');
        }

        function recalc() {
            let total = 0;
            document.querySelectorAll('.qtyInput').forEach(function (input) {
                const saleItemId = parseInt(input.dataset.saleitemid);
                const item = currentItems.find(function (i) { return i.saleItemId === saleItemId; });
                const qty = parseInt(input.value) || 0;
                total += qty * item.unitPrice;
            });
            document.getElementById('refundDisplay').textContent = total.toFixed(2);
        }

        processBtn.addEventListener('click', async function () {
            const lines = [];
            document.querySelectorAll('.qtyInput').forEach(function (input) {
                const qty = parseInt(input.value) || 0;
                if (qty > 0) {
                    const saleItemId = parseInt(input.dataset.saleitemid);
                    const item = currentItems.find(function (i) { return i.saleItemId === saleItemId; });
                    lines.push({ saleItemId: saleItemId, productId: item.productId, quantity: qty, unitPrice: item.unitPrice });
                }
            });

            if (lines.length === 0) { alert('Enter a return quantity for at least one item.'); return; }

            const btn = this;
            btn.disabled = true;
            btn.textContent = 'Processing...';

            try {
                const payload = {
                    saleId: currentSaleId,
                    reason: document.getElementById('reason').value,
                    notes: document.getElementById('notes').value,
                    refundMethod: document.getElementById('refundMethod').value,
                    items: lines
                };

                const res = await fetch('/Returns/Process', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });

                const result = await res.json();
                const msgDiv = document.getElementById('resultMessage');

                if (!res.ok) {
                    msgDiv.innerHTML = '<div class="alert alert-danger">' + result.message + '</div>';
                    return;
                }

                msgDiv.innerHTML = '<div class="alert alert-success">Return ' + result.returnNo + ' processed. Refund: ' + result.refundTotal.toFixed(2) + '</div>';
                returnSection.style.display = 'none';
                invoiceInput.value = '';
            } finally {
                btn.disabled = false;
                btn.textContent = 'Process Return';
            }
        });
    </script>
}