@model List<POSSystem.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    var userEmails = (Dictionary<string, string>)ViewBag.UserEmails;
}

<h1>Audit Log</h1>

<form method="get" asp-controller="AuditLogs" asp-action="Index" class="row mb-3">
    <div class="col-md-3">
        <label class="form-label">Entity Type</label>
        <select name="entityType" class="form-select">
            <option value="">All</option>
            <option value="Sale" selected="@(ViewBag.EntityType == "Sale")">Sale</option>
            <option value="SaleReturn" selected="@(ViewBag.EntityType == "SaleReturn")">Return</option>
            <option value="Purchase" selected="@(ViewBag.EntityType == "Purchase")">Purchase</option>
            <option value="Product" selected="@(ViewBag.EntityType == "Product")">Product</option>
            <option value="Expense" selected="@(ViewBag.EntityType == "Expense")">Expense</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-secondary">Filter</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Reference</th><th>Summary</th></tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(userEmails.ContainsKey(log.UserId) ? userEmails[log.UserId] : log.UserId)</td>
                <td>@log.Action</td>
                <td>@log.EntityType</td>
                <td>@log.EntityId</td>
                <td>@log.Summary</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="text-muted">No audit entries yet.</p>
}
